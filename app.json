{
  "expo": {
    "name": "Washroom",
    "slug": "what-mushroom-is-this",
    "scheme": "what-mushroom-is-this",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.factoincognito.mushroomlog",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "ios": {
      "infoPlist": {
        "RCTAsyncStorageExcludeFromBackup": true,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "locales": {
      "sv": "./locales/sv.json",
      "en": "./locales/en.json",
      "it": "./locales/it.json"
    },
    "plugins": [
      ["expo-router", { "sitemap": false }],
      "expo-localization",
      "expo-sqlite",
      ["expo-secure-store", { "faceIDPermission": false, "configureAndroidBackup": false }],
      [
        "expo-image-picker",
        {
          "cameraPermission": "The camera takes the photo of a mushroom for your find log.",
          "photosPermission": "A photo you pick from your library is saved as a find in your log.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is saved with each new find, so your log shows where you found it. It is not sent anywhere.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "./plugins/withBackupRules",
        {
          "exclude": [
            { "domain": "file", "path": "SQLite" },
            { "domain": "file", "path": "photos" },
            { "domain": "database", "path": "." }
          ]
        }
      ],
      ["@maplibre/maplibre-react-native", { "android": { "locationEngine": "default" } }]
    ],
    "extra": {
      "eas": {
        "projectId": "3b682970-bc59-4ead-8128-9055c1112e2c"
      }
    },
    "owner": "factoincognito"
  }
}
