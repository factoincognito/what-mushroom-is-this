{
  "expo": {
    "name": "What mushroom is this?",
    "slug": "what-mushroom-is-this",
    "scheme": "what-mushroom-is-this",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "allowBackup": false
    },
    "ios": {
      "infoPlist": {
        "RCTAsyncStorageExcludeFromBackup": true
      }
    },
    "plugins": [
      ["expo-router", { "sitemap": false }],
      "expo-localization",
      "expo-sqlite",
      ["expo-secure-store", { "faceIDPermission": false, "configureAndroidBackup": false }],
      [
        "expo-image-picker",
        {
          "cameraPermission": "The camera takes the photo of a mushroom for your find log.",
          "photosPermission": "A photo you pick from your library is saved as a find in your log.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is saved with each new find, so your log shows where you found it. It is not sent anywhere."
        }
      ],
      [
        "./plugins/withBackupRules",
        {
          "exclude": [
            { "domain": "file", "path": "SQLite" },
            { "domain": "file", "path": "photos" },
            { "domain": "database", "path": "." }
          ]
        }
      ]
    ]
  }
}
