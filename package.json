{
  "name": "what-mushroom-is-this",
  "version": "0.1.0",
  "description": "Give a forager a quick best assessment of a mushroom from a photo, and a private log of their finds",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "ci": "biome ci --error-on-warnings . && npm run typecheck && jest --coverage --coverageThreshold='{\"global\":{\"lines\":80}}'"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.26",
    "expo-constants": "57.0.23",
    "expo-file-system": "57.0.7",
    "expo-image-manipulator": "57.0.22",
    "expo-image-picker": "57.0.21",
    "expo-linking": "57.0.13",
    "expo-localization": "57.0.2",
    "expo-network": "57.0.3",
    "expo-router": "57.0.30",
    "expo-secure-store": "57.0.4",
    "expo-sqlite": "57.0.4",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "/android/",
      "/ios/",
      "/dist/"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/testing/**"
    ]
  }
}
